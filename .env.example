# The corpora are private: they never reach the browser and are not in this repository.

# Production: a private GitHub repository holding fr.txt and en.txt.
# The token only needs read access to that repository's contents.
CORPUS_GITHUB_REPO=owner/kawalyser-corpus
CORPUS_GITHUB_TOKEN=
# Optional: folder inside the repository, and branch or tag.
CORPUS_GITHUB_DIR=
CORPUS_GITHUB_REF=

# Local development: without the GitHub variables, the corpora are read from this folder
# (default: corpus/ at the project root, which git ignores).
# CORPUS_DIR=/path/to/corpus

# Canonical links, the sitemap and social cards use VERCEL_PROJECT_PRODUCTION_URL, which Vercel sets on
# every deployment (the custom domain once there is one). Without it, they point at http://localhost:3000.
